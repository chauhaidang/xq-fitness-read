<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Read Service Test Suite" verbose="1">

    <!-- Unit Tests Suite -->
    <test name="Unit Tests" enabled="false">
        <packages>
            <package name="com.xqfitness.readservice.service"/>
            <package name="com.xqfitness.readservice.controller"/>
            <package name="com.xqfitness.readservice.dto"/>
        </packages>
        <groups>
            <run>
                <exclude name="component"/>
                <exclude name="integration"/>
            </run>
        </groups>
    </test>

    <!-- Component/Integration Tests Suite -->
    <test name="Component Tests">
        <groups>
            <run>
                <include name="component"/>
            </run>
        </groups>
        <packages>
            <package name="com.xqfitness.readservice.component"/>
        </packages>
    </test>

</suite>
